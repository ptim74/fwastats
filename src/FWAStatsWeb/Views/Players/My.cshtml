@model FWAStatsWeb.Models.PlayerViewModels.MyPlayersViewModel
@using FWAStatsWeb.Logic

@{
    ViewBag.Title = "My players";
    ViewBag.MetaRobots = "noindex, nofollow";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">My Players</li>
    </ol>
</nav>

<h2>My Players</h2>

<nav aria-label="Player navigation">
    <ul class="pagination">
        <li class="page-item"><a class="page-link" asp-area="" asp-controller="Players" asp-action="Index">Search players</a></li>
        <li class="page-item active"><a class="page-link" asp-area="" asp-controller="Players" asp-action="My">My players</a></li>
    </ul>
</nav>

<table class="table table-hover table-responsive table-sort">
    <thead>
        <tr>
            <th>
                Name
            </th>
            <th>
                Clan
            </th>
            <th data-sort-method="none">

            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var player in Model.Players)
        {
            <tr>
                <td>
                    <a asp-route-id="@player.LinkID" asp-area="" asp-controller="Players" asp-action="Details">@player.Name</a>
                </td>
                <td>
                    @if(player.IsError)
                    {
                        <span class="text-danger">Failed to load player details</span>
                    }
                    else
                    {
                        <a asp-route-id="@player.ClanLinkID" asp-area="" asp-controller="Clans" asp-action="Details">@player.ClanName</a>
                    }
                </td>
                <td>
                    <a asp-area="" asp-route-id="@player.LinkID" asp-controller="Players" asp-action="Unlink" class="btn btn-danger">Unlink</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="Players" asp-action="NewLink" class="btn btn-primary">Link new player</a>

<div class="alert alert-info mt-4">
    <strong>Info!</strong>
    You can link players if you click the link on upper right corner in player details page.
</div>

@section scripts {
    <script type="text/javascript">
        (function() {
            initPlayersMy();
        })();
    </script>
}
