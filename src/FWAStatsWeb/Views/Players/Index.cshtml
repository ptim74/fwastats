@model FWAStatsWeb.Models.PlayerViewModels.SearchViewModel
@using FWAStatsWeb.Logic

@{
    ViewBag.Title = "Search players";
    ViewBag.MetaRobots = "noindex, nofollow";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Players</li>
    </ol>
</nav>

<h2>Players</h2>

<nav aria-label="Player navigation">
    <ul class="pagination">
        <li class="page-item active"><a class="page-link" asp-area="" asp-controller="Players" asp-action="Index">Search players</a></li>
        <li class="page-item"><a class="page-link" asp-area="" asp-controller="Players" asp-action="My">My players</a></li>
    </ul>
</nav>

<form asp-action="Index" method="get">
    <div class="input-group mb-4">
        <span class="input-group-text" id="basic-addon1"><span class="fas fa-search"></span></span>
        <input type="text" id="q" name="q" value="@Model.Query" class="form-control" placeholder="Search by Name or Tag" aria-describedby="basic-addon1" />
        <button type="submit" class="btn btn-success">Go</button>
    </div>
</form>

@if (Model.Results != null && Model.Results.Count > 0)
{
    <table class="table table-hover table-responsive table-sort">
        <thead>
            <tr>
                <th>
                    Tag
                </th>
                <th>
                    Name
                </th>
                <th>
                    Clan
                </th>
                <th>
                    Last Seen
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var player in Model.Results)
            {
                <tr>
                    <td>@player.Tag</td>
                    <td>
                        <a asp-route-id="@player.LinkID" asp-area="" asp-controller="Players" asp-action="Details">@player.Name</a>
                    </td>
                    <td>
                        <a asp-route-id="@player.ClanLinkID" asp-area="" asp-controller="Clans" asp-action="Details">@player.ClanName</a>
                    </td>
                    <td data-sort="@player.LastSeen.ToString("s")">
                        @player.TimeDesc()
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Model.Results != null && Model.Results.Count == 0)
{
    <div class="alert alert-info">
        <strong>Info: </strong>No results
    </div>
}

@if (Model.Results != null && Model.Results.Count == 100)
{
    <div class="alert alert-info">
        <strong>Info: </strong>Showing only first 100 results.
    </div>
}

@section scripts {
    <script type="text/javascript">
        (function() {
            initPlayersIndex();
        })();
    </script>
}


