@{
    ViewData["Title"] = "Locked out";
}

<div class="col-md-6 col-md-offset-3 col-sm-8 col-sm-offset-2">
    <div class="card">
        <div class="card-header text-bg-danger">
            @ViewData["Title"]
        </div>
        <div class="card-body">

            <p>
                This account has been locked out, please try again later.
            </p>

        </div>
    </div>
</div>