@using System.Collections.Generic
@using Microsoft.AspNetCore.Http
@model RegisterViewModel
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = "Register";
}

<div class="col-md-6 offset-md-3 col-sm-8 offset-sm-2">
    <div class="card">
        <div class="card-header">
            @ViewData["Title"]
        </div>
        <div class="card-body">

            @foreach (var provider in (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToList())
            {
                <form asp-controller="Account" asp-action="ExternalLogin" id="login-@provider.Name">
                    <input type="hidden" name="returnurl" value="@ViewData["ReturnUrl"]" />
                    <input type="hidden" name="provider" value="@provider.Name" />
                </form>
            }

        <form asp-controller="Account" asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" role="form">

            <div class="text-danger">
                @Html.ValidationSummary(true)
            </div>

            <span asp-validation-for="Email" class="text-danger"></span>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="Email" autocomplete="off">
                </div>
            </div>

            <span asp-validation-for="Password" class="text-danger"></span>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                    <input asp-for="Password" class="form-control" placeholder="Password">
                </div>
            </div>

            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm Password">
                </div>
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <input asp-for="AcceptPrivacyPolicy" class="form-check-input" />
                    <label asp-for="AcceptPrivacyPolicy" class="form-check-label">
                        @Html.DisplayNameFor(m => m.AcceptPrivacyPolicy)
                    </label>
                </div>
                <ul class="mt-2">
                    <li>Click here to read <a asp-controller="Home" asp-action="PrivacyPolicy">Privacy Policy</a></li>
                </ul>
            </div>

            <div class="mb-3">
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success">Create account</button>
                    @{
                        var providers = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToList();
                        if (providers.Count > 0)
                        {
                            <text>or</text>
                        }
                    }
                    @foreach (var provider in providers)
                    {
                        <a href="#" onClick="document.getElementById('login-@provider.Name').submit()" class="btn btn-primary">Register using @provider.DisplayName account</a>
                    }
                </div>
            </div>

            <div class="mb-3">
                <div class="border-top pt-3" style="font-size:85%">
                    Already registered,
                    <a asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]">Login Here</a>
                </div>
            </div>

        </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
