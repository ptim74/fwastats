@model VerifyCodeViewModel
@{
    ViewData["Title"] = "Verify";
}

<div class="col-md-6 offset-md-3 col-sm-8 offset-sm-2">
    <div class="card">
        <div class="card-header">
            @ViewData["Title"]
        </div>
        <div class="card-body">

            <form asp-controller="Account" asp-action="VerifyCode" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">

                <div asp-validation-summary="All" class="text-danger"></div>

                <input asp-for="Provider" type="hidden" />
                <input asp-for="RememberMe" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Code" class="col-md-3 form-label"></label>
                    <div class="">
                        <input asp-for="Code" class="form-control" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <div>
                        <div class="form-check">
                            <input asp-for="RememberBrowser" class="form-check-input" />
                            <label asp-for="RememberBrowser" class="form-check-label"></label>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <div>
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
