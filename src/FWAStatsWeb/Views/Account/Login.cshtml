@using System.Collections.Generic
@using Microsoft.AspNetCore.Http
@model LoginViewModel
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = "Login";
    ViewBag.MetaRobots = "noindex, nofollow";
}

<div class="col-md-6 offset-md-3 col-sm-8 offset-sm-2">
    <div class="card">
        <div class="card-header">
            @ViewData["Title"]
        </div>
        <div class="card-body">

            <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" id="login-Local" role="form">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <span asp-validation-for="Email" class="text-danger"></span>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="Email">
                    </div>
                </div>

                <span asp-validation-for="Password" class="text-danger"></span>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="Password">
                    </div>
                </div>

                <span asp-validation-for="RememberMe" class="text-danger"></span>
                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">
                            @Html.DisplayNameFor(m => m.RememberMe)
                        </label>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-grid gap-2">
                        <a href="#" onClick="document.getElementById('login-Local').submit()" class="btn btn-success">Login</a>
                        @{
                            var providers = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToList();
                            if (providers.Count > 0)
                            {
                                <text>or</text>
                            }
                        }
                        @foreach (var provider in providers)
                        {
                            <a href="#" onClick="document.getElementById('login-@provider.Name').submit()" class="btn btn-primary">Login with @provider.DisplayName</a>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <div class="border-top pt-3" style="font-size:85%">
                        Don't have an account!
                        <a asp-controller="Account" asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]">
                            Register Here
                        </a>
                        <br />
                        Forgot your password?
                        <a asp-action="ForgotPassword">
                            Click Here to Reset Your Password
                        </a>
                    </div>
                </div>

            </form>

            @foreach (var provider in (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToList())
            {
                <form asp-controller="Account" asp-action="ExternalLogin" id="login-@provider.Name">
                    <input type="hidden" name="returnurl" value="@ViewData["ReturnUrl"]" />
                    <input type="hidden" name="provider" value="@provider.Name" />
                </form>
            }

            <div class="alert alert-info">
                <strong>Why Login is Now Required</strong><br />
                <p>Due to excessive automated traffic from AI crawlers and bots, we've had to move most of our data behind a login wall to protect our server resources and keep the site running smoothly for our FWA community.</p>
                <p><strong>For existing users:</strong> Simply log in to access all features as before.</p>
                <p><strong>New to our site?</strong> Registration is quick and free - we just need to verify you're a real person interested in our FWA community.</p>
                <p>Thanks for your understanding!</p>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
