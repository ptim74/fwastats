@model ExternalLoginConfirmationViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="col-md-6 offset-md-3 col-sm-8 offset-sm-2">
    <div class="card">
        <div class="card-header">
            Associate @ViewData["LoginProvider"] account
        </div>
        <div class="card-body">

            <form asp-controller="Account" asp-action="ExternalLoginConfirmation" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">

                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="alert alert-success">
                    <strong>Success!</strong>
                    You've successfully authenticated with <strong>@ViewData["LoginProvider"]</strong>.
                    Please enter an email address for this site below and click the Register button to finish
                    logging in.
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="col-md-3 form-label"></label>
                    <div class="">
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <div>
                        <button type="submit" class="btn btn-primary">Register</button>
                    </div>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}