@model SendCodeViewModel
@{
    ViewData["Title"] = "Send Verification Code";
}

<div class="col-md-6 offset-md-3 col-sm-8 offset-sm-2">
    <div class="card">
        <div class="card-header">
            @ViewData["Title"]
        </div>
        <div class="card-body">

            <form asp-controller="Account" asp-action="SendCode" asp-route-returnurl="@Model.ReturnUrl" method="post">

                <input asp-for="RememberMe" type="hidden" />

                <div class="mb-3">
                    <label asp-for="SelectedProvider" class="col-md-3 form-label"></label>
                    <div class="">
                        <select asp-for="SelectedProvider" asp-items="Model.Providers" class="form-select"></select>
                        <span asp-validation-for="SelectedProvider" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <div>
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
