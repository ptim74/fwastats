@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, WebOptimizer.Core
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @if (ViewData.ContainsKey("MetaRobots"))
    {
        <meta name="robots" content="@ViewData["MetaRobots"]" />
    }

    <title>@ViewData["Title"] 💎 FWA Stats</title>
    <meta property="og:title" content="@ViewData["Title"] 💎 FWA Stats" />

    @if (ViewData.ContainsKey("MetaDescription"))
    {
        <meta name="description" content="@ViewData["MetaDescription"]" />
        <meta property="og:description" content="@ViewData["MetaDescription"]" />
    }

    @if (ViewData.ContainsKey("MetaImage"))
    {
        <meta property="og:image" content="@ViewData["MetaImage"]" />
    }
    else
    {
        <meta property="og:image" content="@Url.Content("~/images/balloon_parade.jpg")" />
    }

    <environment names="Development">
        <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    </environment>
    <environment names="Staging,Production">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.7/css/bootstrap.min.css" 
              asp-fallback-href="~/lib/bootstrap/css/bootstrap.min.css" 
              asp-fallback-test-class="visually-hidden"
              asp-fallback-test-property="position" 
              asp-fallback-test-value="absolute" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" 
              asp-fallback-href="~/lib/font-awesome/css/all.min.css" 
              asp-fallback-test-class="fa" 
              asp-fallback-test-property="display" 
              asp-fallback-test-value="inline-block" />
        <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
        <!-- Global site tag (gtag.js) - Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-24G3LCZ85Z"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());

            gtag('config', 'G-24G3LCZ85Z');
        </script>
    </environment>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="navbar-brand">💎 FWA Stats</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Clans" asp-action="Index">Clans</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Syncs" asp-action="Index">Syncs</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Players" asp-action="Index">Players</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Data" asp-action="Index">Data</a></li>
                </ul>
                @*
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">About</a></li>
                </ul>
                *@
                @await Html.PartialAsync("_LoginPartial")
            </div>
        </div>
    </nav>
        <div class="container body-content fill">
            @RenderBody()
            <div class="col-sm-12">
                <hr />
                <p>
                    <small class="text-muted">
                        This content is not affiliated with, endorsed, sponsored, or specifically approved by Supercell and Supercell is not responsible for it.
                        For more information see Supercell’s Fan Content Policy: <a href="http://www.supercell.com/fan-content-policy">www.supercell.com/fan-content-policy</a>.
                        This website uses cookies and may store your personal information, more details in <a asp-controller="Home" asp-action="PrivacyPolicy">Privacy Policy</a>.
                    </small>
                </p>
            </div>
        </div>

        @RenderSection("modals", required: false)

        <environment names="Development">
            <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
            <script src="~/lib/tablesort/tablesort.min.js"></script>
            <script src="~/lib/tablesort/sorts/tablesort.number.min.js"></script>
            <script src="~/js/site.js" asp-append-version="true"></script>
        </environment>
        <environment names="Staging,Production">
            <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.7/js/bootstrap.bundle.min.js"
                    asp-fallback-src="~/lib/bootstrap/js/bootstrap.bundle.min.js"
                    asp-fallback-test="window.bootstrap">
            </script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/tablesort/5.2.1/tablesort.min.js"
                    asp-fallback-src="~/lib/tablesort/tablesort.min.js"
                    asp-fallback-test="window.Tablesort">
            </script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/tablesort/5.2.1/sorts/tablesort.number.min.js">
            </script>
            <script src="~/js/site.min.js" asp-append-version="true"></script>
        </environment>

        @RenderSection("scripts", required: false)

    </body>
</html>
