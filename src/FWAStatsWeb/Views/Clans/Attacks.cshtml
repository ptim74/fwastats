@model FWAStatsWeb.Models.ClanViewModels.ClanAttackModel

@{
    ViewData["Title"] = Model.Name + " Attack Summary";
    ViewBag.MetaImage = Model.BadgeUrl;
    ViewBag.MetaRobots = "noindex, nofollow";
    ICollection<WarAttack> attacks;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Clans" asp-action="Index">Clans</a></li>
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Clans" asp-action="Details" asp-route-id="@Model.LinkID">@Model.Name</a></li>
        <li class="breadcrumb-item active" aria-current="page">Attack Summary</li>
    </ol>
</nav>

<div class="well card p-3 mt-4">
    <div class="row">
        <div class="col">
            <img src="@Model.BadgeUrl" class="badge-70 float-start me-2 ms-2" />
            <h3 class="mt-2 mb-0">@Model.Name</h3>
            <div class="text-muted">
                @Model.Tag
                <a class="text-muted" href="@Constants.CHOCOLATECLASH/clan.php?tag=@Model.LinkID"><span class="fas fa-link"></span>C<span class="d-none d-sm-inline">hocolate</span>C<span class="d-none d-sm-inline">lash</span></a>
                <a class="text-muted" href="@Constants.FWAPOINTS/clan?tag=@Model.LinkID"><span class="fas fa-link"></span><span class="d-none d-sm-inline">FWA </span>P<span class="d-none d-sm-inline">oin</span>ts</a>
                <a class="text-muted" href="@Constants.CLASHOFSTATS/clans/@Model.LinkID"><span class="fas fa-link"></span>C<span class="d-none d-sm-inline">lash </span>o<span class="d-none d-sm-inline">f </span>S<span class="d-none d-sm-inline">tats</span></a>
            </div>
        </div>
    </div>
</div>

<h4>Attack Summary</h4>

<table class="table table-sm table-hover table-responsive table-sort">
    <thead>
        <tr>
            <th>Name</th>
            @foreach (var war in Model.Wars)
            {
                <th>@war.OpponentName</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model.Members)
        {
        <tr>
            <td><a asp-route-id="@member.LinkID" asp-area="" asp-controller="Players" asp-action="Details">@member.Name</a></td>
            @foreach (var war in Model.Wars)
            {
                <td class="text-nowrap">
                    @if (member.Attacks.TryGetValue(war.ID, out attacks))
                    {
                        foreach (var attack in attacks)
                        {
                            @for (var starCount = 0; starCount < attack.Stars; starCount++)
                            {
                                <text>⭐</text>
                            }
                            if (attack.Stars == 0)
                            {
                                <span class="badge text-bg-info">0 Stars</span>
                            }
                            <span>#@attack.DefenderMapPosition</span>
                            <br />
                        }
                        for (int i = attacks.Count; i < 2; i++)
                        {
                            <span class="badge text-bg-secondary">Not Used</span>
                            <br />
                        }
                    }
                    else
                    {
                        <span class="badge text-bg-danger">Opt Out</span>
                    }
                </td>
            }
        </tr>
        }
    </tbody>
</table>

@section scripts {
    <script type="text/javascript">
        (function() {
            initClansAttacks();
        })();
    </script>
}
