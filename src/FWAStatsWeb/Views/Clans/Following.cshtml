@model List<FWAStatsWeb.Models.ClanViewModels.FollowingClan>

@{
    ViewBag.Title = "Following Clans";
    ViewBag.MetaRobots = "noindex, nofollow";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Clans" asp-action="Index">Clans</a></li>
        <li class="breadcrumb-item active" aria-current="page">Following Clans</li>
    </ol>
</nav>

<h2>Following Clans</h2>

<nav aria-label="Clan navigation">
    <ul class="pagination">
        <li class="page-item"><a class="page-link" asp-area="" asp-controller="Clans" asp-action="Index">Active</a></li>
        <li class="page-item"><a class="page-link" asp-area="" asp-controller="Clans" asp-action="Departed">Departed</a></li>
        <li class="page-item active"><a class="page-link" asp-area="" asp-controller="Clans" asp-action="Following">Following</a></li>
        <li class="page-item"><a class="page-link" asp-area="" asp-controller="Clans" asp-action="My">My clans</a></li>
    </ul>
</nav>

<div class="input-group mb-4">
    <span class="input-group-text" id="basic-addon1"><span class="fas fa-search"></span></span>
    <input type="text" id="search" class="form-control" placeholder="Search" aria-describedby="basic-addon1" />
</div>

<table id="table" class="table table-hover table-responsive table-sort">
    <thead>
        <tr>
            <th width="35" data-sort-method="none"></th>
            <th>
                Clan
            </th>
            <th>
                Wars
            </th>
            <th>
                Latest
            </th>
            <th>
                Against
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var clan in Model)
        {
            <tr>
                <td class="p-0">
                    <img src="@clan.BadgeURL" class="badge-35" />
                </td>
                <td>
                    <a asp-route-id="@clan.LinkID" asp-area="" asp-controller="Clans" asp-action="Details" class="table-search">@clan.Name</a>
                    @if (clan.Blacklisted)
                    {
                        <small class="badge text-bg-secondary">B<span class="d-none d-sm-inline">lacklisted</span></small>
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => clan.Wars)
                </td>
                <td>
                    @clan.LatestDate.ToString("yyyy-MM-dd")
                </td>
                <td>
                    <a asp-route-id="@clan.LatestLinkID" asp-area="" asp-controller="Clans" asp-action="Details">@clan.LatestClan</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section scripts {
    <script type="text/javascript">
        (function() {
            initClansFollowing();
        })();
    </script>
}