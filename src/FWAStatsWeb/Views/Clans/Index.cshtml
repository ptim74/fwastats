@model FWAStatsWeb.Models.ClanViewModels.IndexViewModel

@{
    ViewBag.Title = Model.IsMyClans ? "My clans" : "Clans";
    ViewBag.MetaDescription = "List of clans in FWA, Farm War Alliance, Clash of Clans";
    ViewBag.MetaRobots = "nofollow";
    var activeClansClass = Model.IsMyClans ? "" : "active";
    var myClansClass = Model.IsMyClans ? "active" : "";

}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
        @if (Model.IsMyClans)
        {
            <li class="breadcrumb-item"><a asp-area="" asp-controller="Clans" asp-action="Index">Clans</a></li>
        }
        <li class="breadcrumb-item active" aria-current="page">@ViewBag.Title</li>
    </ol>
</nav>

<h2>@ViewBag.Title</h2>

<nav aria-label="Clan navigation">
    <ul class="pagination">
        <li class="page-item @activeClansClass"><a class="page-link" asp-area="" asp-controller="Clans" asp-action="Index">Active</a></li>
        <li class="page-item"><a class="page-link" asp-area="" asp-controller="Clans" asp-action="Departed">Departed</a></li>
        <li class="page-item"><a class="page-link" asp-area="" asp-controller="Clans" asp-action="Following">Following</a></li>
        <li class="page-item @myClansClass"><a class="page-link" asp-area="" asp-controller="Clans" asp-action="My">My clans</a></li>
    </ul>
</nav>

<div class="input-group mb-4">
    <span class="input-group-text" id="basic-addon1"><span class="fas fa-search"></span></span>
    <input type="text" id="search" class="form-control" placeholder="Search" aria-describedby="basic-addon1" />
</div>

<table id="table" class="table table-hover table-responsive table-sort">
    <thead>
        <tr>
            <th width="35" data-sort-method="none"></th>
            <th>
                Clan
            </th>
            <th>
                <span class="fas fa-user"></span>
            </th>
            <th>
                <span>TH17</span>
            </th>
            <th>
                <span>TH16</span>
            </th>
            <th>
                <span>TH15</span>
            </th>
            <th>
                <span>TH14</span>
            </th>
            <th>
                <span>TH13</span>
            </th>
            <th>
                <span>TH12</span>
            </th>
            <th>
                <span>TH11</span>
            </th>
            <th>
                <span>TH10</span>
            </th>
            <th>
                <span>TH9</span>
            </th>
            <th>
                <span>TH8</span>
            </th>
            <th>
                <span>TH7-</span>
            </th>
            <th>
                <span>Est.W<span class="d-none d-sm-inline">eight</span></span>
            </th>
            <th>
                <span>Wars</span>
            </th>
            <th>
                <span>M<span class="d-none d-sm-inline">atch</span>%</span>
            </th>
            <th>
                <span>W<span class="d-none d-sm-inline">in</span>%</span>
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var clan in Model)
        {
            <tr>
                <td class="p-0">
                    <img src="@clan.BadgeUrl" class="badge-35" />
                </td>
                <td>
                    <a asp-route-id="@clan.LinkID" asp-area="" asp-controller="Clans" asp-action="Details" class="table-search">@clan.Name</a>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => clan.Members)
                </td>
                <td>
                    @clan.Th17Count
                </td>
                <td>
                    @clan.Th16Count
                </td>
                <td>
                    @clan.Th15Count
                </td>
                <td>
                    @clan.Th14Count
                </td>
                <td>
                    @clan.Th13Count
                </td>
                <td>
                    @clan.Th12Count
                </td>
                <td>
                    @clan.Th11Count
                </td>
                <td>
                    @clan.Th10Count
                </td>
                <td>
                    @clan.Th9Count
                </td>
                <td>
                    @clan.Th8Count
                </td>
                <td>
                    @clan.ThLowCount
                </td>
                <td>
                    @clan.EstimatedWeight
                </td>
                <td>
                    @clan.WarCount
                </td>
                <td>
                    @clan.MatchPercentage
                </td>
                <td>
                    @clan.WinPercentage
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.IsMyClans)
{
    <div class="alert alert-info">
        <strong>Note!</strong>
        Showing only your clans in FWA.
    </div>
}

@section scripts {
    <script type="text/javascript">
        (function() {
            initClansIndex();
        })();
    </script>
}