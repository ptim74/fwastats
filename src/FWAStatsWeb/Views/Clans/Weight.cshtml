@model FWAStatsWeb.Models.ClanViewModels.WeightViewModel

@{
    ViewBag.Title = Model.ClanName + " Weight";
    ViewBag.MetaImage = Model.ClanBadge;
    ViewBag.MetaRobots = "noindex, nofollow";
    int member_id = 0;
    string resultType = "alert-success";
    string resultMessage = "";
    if (Model.PendingWeightSubmit)
    {
        resultType = "alert-warning";
        resultMessage = "Clan has pending weight submit response which has to be approved by FWA weight department.";
    }
    else
    {
        resultMessage = string.Format("Clan weight submitted {0}.", FWAStatsWeb.Logic.Utils.TimeSpanToString(DateTime.UtcNow.Subtract(Model.WeightSubmitDate)));
        if (Model.WeightSubmitDate == DateTime.MinValue)
        {
            resultMessage = "Weight submit results not found.";
        }
        if (Model.WeightSubmitDate > DateTime.Now.AddDays(-28))
        {
            resultType = "alert-success";
        }
        else if (Model.WeightSubmitDate > DateTime.Now.AddDays(-42))
        {
            resultType = "alert-warning";
        }
        else
        {
            resultType = "alert-danger";
        }
    }
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Clans" asp-action="Index">Clans</a></li>
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Clans" asp-action="Details" asp-route-id="@Model.ClanLink">@Model.ClanName</a></li>
        <li class="breadcrumb-item active" aria-current="page">Weight</li>
    </ol>
</nav>

<div class="well card p-3 mt-4">
    <div class="row">
        <div class="col">
            <img src="@Model.ClanBadge" class="badge-70 float-start me-2 ms-2" />
            <h3 class="mt-2 mb-0">@Model.ClanName</h3>
            <div class="text-muted">
                @Model.ClanTag
                <a class="text-muted" href="@Constants.CHOCOLATECLASH/clan.php?tag=@Model.ClanLink"><span class="fas fa-link"></span>C<span class="d-none d-sm-inline">hocolate</span>C<span class="d-none d-sm-inline">lash</span></a>
                <a class="text-muted" href="@Constants.FWAPOINTS/clan?tag=@Model.ClanLink"><span class="fas fa-link"></span><span class="d-none d-sm-inline">FWA </span>P<span class="d-none d-sm-inline">oin</span>ts</a>
                <a class="text-muted" href="@Constants.CLASHOFSTATS/clans/@Model.ClanLink"><span class="fas fa-link"></span>C<span class="d-none d-sm-inline">lash </span>o<span class="d-none d-sm-inline">f </span>S<span class="d-none d-sm-inline">tats</span></a>
            </div>
        </div>
    </div>
</div>

<h4>Edit Clan Weight</h4>

<div class="alert @resultType">
    <strong>@resultMessage</strong><br />
    If you want to submit weights to the official FWA weight sheet, first select war roster from below and then click submit from the bottom of the page.
</div>

<form id="form1" asp-action="Weight">
    <input type="hidden" asp-for="ClanTag" />
    <div class="mb-3">
        <label for="WarID" class="form-label">Select members</label>
        <select class="form-select" id="WarID" name="WarID" onchange='this.form.submit()'>
            <!option @(Model.WarID == 0 ? "selected='selected'" : "") value="0">All Members</!option>
            @foreach (var war in Model.Wars)
            {
                <!option @(Model.WarID == war.ID ? "selected='selected'" : "") value="@war.ID">War against @war.OpponentName</!option>
            }
        </select>
    </div>
</form>

@if (Model.Comparisons != null)
{
    int me = (int)(Model.ComparisonDeviation / Model.ComparisonSampleSize);
    <div id="chart"></div>
    <div class="caption">
        <p class="small">Weight of selected roster compared against average of @Model.ComparisonSampleSize weight submit results close to selected weight (+/- @Constants.WEIGHT_COMPARE). 
        <!--Mean absolute deviation is @Model.ComparisonDeviation and mean absolute error is @me. -->
        </p>
    </div>
}
else
{
    if (Model.WarID == 0)
    {
        <div class="caption">
            <p class="small">To see the weight chart please fill weights for @Constants.WAR_SIZE1 or @Constants.WAR_SIZE2 or @Constants.WAR_SIZE3 selected members.</p>
        </div>
    }
    else
    {
        <div class="caption">
            <p class="small">To see the weight chart please fill weights for all war members.</p>
        </div>
    }
}

<form id="form2" asp-action="Weight">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="ClanTag" />
    <input type="hidden" asp-for="ClanName" />
    <input type="hidden" asp-for="WarID" />
    <table id="myTable" class="table table-sm table-hover table-sort">
        <thead>
            <tr>
                <th>
                    #
                </th>
                <th>
                    Name
                </th>
                <th data-sort-method="none">
                    Weight
                </th>
                <th data-sort-method="none">
                    InWar
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in Model.Members)
            {
                var member_max = 0;
                switch (member.TownHallLevel)
                {
                    case 18:
                        member_max = Constants.MAXWEIGHT_TH18;
                        break;
                    case 17:
                        member_max = Constants.MAXWEIGHT_TH17;
                        break;
                    case 16:
                        member_max = Constants.MAXWEIGHT_TH16;
                        break;
                    case 15:
                        member_max = Constants.MAXWEIGHT_TH15;
                        break;
                    case 14:
                        member_max = Constants.MAXWEIGHT_TH14;
                        break;
                    case 13:
                        member_max = Constants.MAXWEIGHT_TH13;
                        break;
                    case 12:
                        member_max = Constants.MAXWEIGHT_TH12;
                        break;
                    case 11:
                        member_max = Constants.MAXWEIGHT_TH11;
                        break;
                    case 10:
                        member_max = Constants.MAXWEIGHT_TH10;
                        break;
                    case 9:
                        member_max = Constants.MAXWEIGHT_TH9;
                        break;
                    case 8:
                        member_max = Constants.MAXWEIGHT_TH8;
                        break;
                    default:
                        member_max = Constants.MAXWEIGHT_TH7;
                        break;
                }
                var member_class = member.InWar ? "table-success" : "table-danger";
                var member_checked = member.InWar ? "checked" : "";
                var member_pos = member_id + 1;
                <tr class="@member_class">
                    <td>@member_pos</td>
                    <td>
                        <input type="hidden" name="Members[@member_id].Tag" value="@member.Tag" />
                        @if (member.TownHallLevel == 18 || member.TownHallLevel == 12)
                        {
                            <span class="badge text-bg-primary">@member.TownHallLevel</span>
                        }
                        else if (member.TownHallLevel == 17 || member.TownHallLevel == 11)
                        {
                            <span class="badge text-bg-success">@member.TownHallLevel</span>
                        }
                        else if (member.TownHallLevel == 16 || member.TownHallLevel == 10)
                        {
                            <span class="badge text-bg-danger">@member.TownHallLevel</span>
                        }
                        else if (member.TownHallLevel == 15 || member.TownHallLevel == 9)
                        {
                            <span class="badge text-bg-secondary">@member.TownHallLevel</span>
                        }
                        else if (member.TownHallLevel == 13)
                        {
                            <span class="badge text-bg-info">@member.TownHallLevel</span>
                        }
                        else // 14, 8, 7, ...
                        {
                            <span class="badge text-bg-warning">@member.TownHallLevel</span>
                        }
                        <a asp-route-id="@member.LinkID" asp-area="" asp-controller="Players" asp-action="Details" tabindex="-1">@member.Name</a>
                    </td>
                    <td>
                        <div class="input-group" style="max-width:300px;min-width:190px;">
                            <button type="button" class="btn btn-danger btn-number" data-type="minus" data-field="Members[@member_id].Weight" tabindex="-1">
                                <span class="fas fa-minus"></span>
                            </button>
                            <input type="number" name="Members[@member_id].Weight" war-check="Members[@member_id].InWar" class="form-control input-number member-weight" value="@member.Weight" min="0" max="@member_max" step="1000">
                            <button type="button" class="btn btn-success btn-number" data-type="plus" data-field="Members[@member_id].Weight" tabindex="-1">
                                <span class="fas fa-plus"></span>
                            </button>
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-primary dropdown-toggle rounded-0 rounded-end" data-bs-toggle="dropdown" tabindex="-1">
                                    <span class="caret"></span>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item weight-multiply" multiplier="3" max="@member_max" data-field="Members[@member_id].Weight">3x</a></li>
                                    <li><a class="dropdown-item weight-multiply" multiplier="4" max="@member_max" data-field="Members[@member_id].Weight">4x</a></li>
                                    <li><a class="dropdown-item weight-multiply" multiplier="5" max="@member_max" data-field="Members[@member_id].Weight">5x</a></li>
                                </ul>
                            </div>
                        </div>
                    </td>
                    <td>
                        <input type="checkbox" class="form-check-input member-in-war" name="Members[@member_id].InWar" value="true" @(member.InWar ? "checked=\"checked\"" : "") tabindex="-1" style="width: 1.5rem; height: 1.5rem;" />
                    </td>
                </tr>
                member_id++;
            }
        </tbody>
    </table>

    <div>
        <a class="small" asp-area="" asp-controller="Clans" asp-action="WeightForm" asp-route-id="@Model.ClanLink" asp-route-warid="@Model.WarID">...</a>
    </div>

    <div style="position:fixed;bottom:0px;left:0px;width:100%;height:50px;background-color:black;color:white;z-index:1030;">
        <div class="container">
            <div class="row m-1">
                <div class="col-6">
                    <div class="text-nowrap">W<span class="d-none d-sm-inline">eight</span>: <span id="war-weight"></span> ( <span id="war-members"></span> )</div>
                    <div class="text-nowrap">TH<span class="d-none d-sm-inline"> Comp</span>: <span id="war-composition"></span></div>
                </div>
                <div class="col-6 text-nowrap text-end">
                    @if (Model.WarID != 0 || Model.Members.Count == Constants.WAR_SIZE2)
                    {
                        <input type="submit" class="btn btn-primary" name="command" id="command-submit" value="Submit">
                    }
                    else
                    {
                        <input type="submit" class="btn btn-primary" name="command" id="command-submit-disabled" value="Submit">
                    }
                    <input type="submit" class="btn btn-save" name="command" id="command-save" value="Save">
                </div>
            </div>
        </div>
    </div>

</form>

@section modals {

<div id="submitModal" class="modal fade" tabindex="-1" aria-labelledby="submitModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div id="submitModalHeader" class="modal-header modal-header-primary">
                <div class="d-flex align-items-center">
                    <div id="submitModalAnimation" class="loader"></div>
                    <h4 id="submitModalTitle" class="modal-title loader-title mb-0">Submitting...</h4>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="submit-details">Please wait...</p>
            </div>
            <div class="modal-footer">
                <a id="backup-submit-button" class="btn btn-primary d-none" asp-area="" asp-controller="Clans" asp-action="WeightForm" asp-route-id="@Model.ClanLink" asp-route-warid="@Model.WarID">Submit with Google Forms</a>
                <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
    
}

@section scripts {
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    <script type="text/javascript">
        (function() {
            @{
                var comparisonData = "null";
                if (Model.Comparisons != null)
                {
                    var dataRows = new List<string>();
                    foreach(var c in Model.Comparisons)
                    {
                        dataRows.Add($"[{c.Position}, {c.Weight}, {c.Average.ToString().Replace(",",".")}]");
                    }
                    comparisonData = "[" + string.Join(",", dataRows) + "]";
                }
            }
            
            initClansWeight({
                clanLink: '@Model.ClanLink',
                weightSubmitQueued: @Model.WeightSubmitQueued.ToString().ToLower(),
                weightStatusUrl: '/Clan/@Model.ClanLink/WeightStatus',
                comparisonData: @Html.Raw(comparisonData),
                maxWeights: {
                    TH18: @Constants.MAXWEIGHT_TH18,
                    TH17: @Constants.MAXWEIGHT_TH17,
                    TH16: @Constants.MAXWEIGHT_TH16,
                    TH15: @Constants.MAXWEIGHT_TH15,
                    TH14: @Constants.MAXWEIGHT_TH14,
                    TH13: @Constants.MAXWEIGHT_TH13,
                    TH12: @Constants.MAXWEIGHT_TH12,
                    TH11: @Constants.MAXWEIGHT_TH11,
                    TH10: @Constants.MAXWEIGHT_TH10,
                    TH9: @Constants.MAXWEIGHT_TH9,
                    TH8: @Constants.MAXWEIGHT_TH8,
                    TH7: @Constants.MAXWEIGHT_TH7
                },
                warSizes: {
                    SIZE1: @Constants.WAR_SIZE1,
                    SIZE2: @Constants.WAR_SIZE2,
                    SIZE3: @Constants.WAR_SIZE3
                }
            });
        })();
    </script>
}
