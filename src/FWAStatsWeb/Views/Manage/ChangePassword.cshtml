@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="col-md-6 offset-md-3 col-sm-8 offset-sm-2">
    <div class="card">
        <div class="card-header">
            @ViewData["Title"]
        </div>
        <div class="card-body">

            <form asp-controller="Manage" asp-action="ChangePassword" method="post" role="form">

                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="OldPassword" class="col-md-3 form-label"></label>
                    <div class="">
                        <input asp-for="OldPassword" class="form-control" />
                        <span asp-validation-for="OldPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="col-md-3 form-label"></label>
                    <div class="">
                        <input asp-for="NewPassword" class="form-control" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="col-md-3 form-label"></label>
                    <div class="">
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <div>
                        <button type="submit" class="btn btn-primary">Change Password</button>
                    </div>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

