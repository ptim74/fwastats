@model FWAStatsWeb.Models.HomeViewModels.IndexViewModel

@{
    ViewBag.Title = "";
    ViewBag.MetaDescription = "Statistics of clans in Farm War Alliance (FWA), Clash of Clans";
}

<ol class="breadcrumb">
    <li class="active">Home</li>
</ol>

<div class='bg-light p-5 rounded-3 header-jumbo' style='background-image:url(@Url.Content("~/images/balloon_parade.jpg"))'>
    <h1>💎 FWA Stats</h1>
    <p>
        Statistics about FWA clans and wars.
    </p>
</div>

<div class="row">
    @foreach (var stats in Model.LastStats)
    {
        var chart = "piechart" + stats.Key;
        <div class="col-sm-6">
            <h3 class="my-3">Current war <small class="text-muted">@stats.Key members, @stats.Value.Status</small></h3>
            <div id="@chart" class="chart-container"><p><i class="fas fa-hourglass"></i> Loading...</p></div>
            <div class="mt-2"><a asp-area="" asp-controller="Syncs" asp-action="Details" asp-route-id="@stats.Value.ID" asp-route-teamSize="@stats.Key" class="btn btn-outline-primary">More details</a></div>
        </div>
    }
    @if (@Model.SyncHistory.Count > 0)
    {
        <div class="col-sm-6">
            <h3 class="my-3">Last @Model.SyncHistory.Count wars</h3>
            <div id="areachart" class="chart-container"><p><i class="fas fa-hourglass"></i> Loading...</p></div>
            <div class="mt-2"><a asp-area="" asp-controller="Syncs" asp-action="Index" class="btn btn-outline-primary">More details</a></div>
        </div>
    }
    <div class="col-sm-6">
        <h3 class="my-3">Key numbers</h3>
        <div>
            <table>
                <tr>
                    <td class="p-1"><b>@Model.Counters.ClanCount</b></td>
                    <td class="p-1">clans</td>
                </tr>
                <tr>
                    <td class="p-1"><b>@Model.Counters.MemberCount</b></td>
                    <td class="p-1">members</td>
                </tr>
                <tr>
                    <td class="p-1"><b>@Model.Counters.WinPercentage%</b></td>
                    <td class="p-1">win ratio</td>
                </tr>
                <tr>
                    <td class="p-1"><b>@Model.Counters.MatchPercentage%</b></td>
                    <td class="p-1">match ratio</td>
                </tr>
                <tr>
                    <td class="p-1"><b>@Model.Counters.TeamSize40Wars</b></td>
                    <td class="p-1">40 vs 40 wars</td>
                </tr>
                <tr>
                    <td class="p-1"><b>@Model.Counters.TeamSize45Wars</b></td>
                    <td class="p-1">45 vs 45 wars</td>
                </tr>
                <tr>
                    <td class="p-1"><b>@Model.Counters.TeamSize50Wars</b></td>
                    <td class="p-1">50 vs 50 wars</td>
                </tr>
                <tr>
                    <td class="p-1"><b>@Model.Counters.ClansInLeague</b></td>
                    <td class="p-1">clans in CWL</td>
                </tr>
            </table>
        </div>
        <p class="mt-2"><a asp-area="" asp-controller="Clans" asp-action="Index" class="btn btn-outline-primary">View all clans</a></p>
    </div>
</div>

@section scripts {

    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>

    <script type="text/javascript">
        (function() {
            @{
                var pieCharts = new List<object>();
                foreach (var group in Model.LastStats)
                {
                    var chart = "piechart" + group.Key;
                    var value = group.Value;
                    pieCharts.Add(new {
                        chartId = chart,
                        allianceMatches = value.AllianceMatches,
                        warMatches = value.WarMatches
                    });
                }

                var syncHistoryChart = Model.SyncHistory.Count > 0 ? new {
                    chartId = "areachart",
                    data = Model.SyncHistory.Select(sync => new List<object> { 
                        sync.DisplayName, sync.AllianceMatches, sync.WarMatches, sync.NotStarted 
                    }).ToList()
                } : null;

            }

            initHomeIndex({
                chartData: {
                    pieCharts: @Html.Raw(Json.Serialize(pieCharts)),
                    syncHistoryChart: @Html.Raw(Json.Serialize(syncHistoryChart))
                }
            });
        })();
    </script>
}