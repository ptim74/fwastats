@model FWAStatsWeb.Models.SyncViewModels.DetailsViewModel

@{
    ViewBag.Title = "Sync " + Model.Sync.DisplayName;
    ViewBag.MetaRobots = "noindex, nofollow";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Syncs" asp-action="Index">Syncs</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Sync.DisplayName</li>
    </ol>
</nav>

<h2>@ViewBag.Title</h2>

@{ 
    var team00Active = Model.TeamSize != Constants.WAR_SIZE1 && Model.TeamSize != Constants.WAR_SIZE2 && Model.TeamSize != Constants.WAR_SIZE3 ? "active" : "";
    var team40Active = Model.TeamSize == Constants.WAR_SIZE1 ? "active" : "";
    var team50Active = Model.TeamSize == Constants.WAR_SIZE2 ? "active" : "";
    var team45Active = Model.TeamSize == Constants.WAR_SIZE3 ? "active" : "";
}

<nav aria-label="War size navigation">
    <ul class="pagination">
        <li class="page-item @team00Active"><a class="page-link" asp-area="" asp-controller="Syncs" asp-action="Details" asp-route-id="@Model.Sync.ID" asp-route-teamSize="">All</a></li>
        <li class="page-item @team40Active"><a class="page-link" asp-area="" asp-controller="Syncs" asp-action="Details" asp-route-id="@Model.Sync.ID" asp-route-teamSize="40">40 vs 40</a></li>
        <li class="page-item @team45Active"><a class="page-link" asp-area="" asp-controller="Syncs" asp-action="Details" asp-route-id="@Model.Sync.ID" asp-route-teamSize="45">45 vs 45</a></li>
        <li class="page-item @team50Active"><a class="page-link" asp-area="" asp-controller="Syncs" asp-action="Details" asp-route-id="@Model.Sync.ID" asp-route-teamSize="50">50 vs 50</a></li>
    </ul>
</nav>

<div class="input-group mb-4">
    <span class="input-group-text" id="basic-addon1"><span class="fas fa-search"></span></span>
    <input type="text" id="search" class="form-control" placeholder="Search" aria-describedby="basic-addon1" />
</div>

<table id="table" class="table table-condensed table-hover table-responsive table-sort">
    <thead>
        <tr>
            <th class="text-right">Clan</th>
            <th width="35" data-sort-method="none"></th>
            <th class="text-nowrap text-center" width="35" data-sort-method="none">
                Result
            </th>
            <th width="35" data-sort-method="none"></th>
            <th>
                Opponent
            </th>
            <th>
                Search Time
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var war in Model.Wars)
        {
            var offset = war.PreparationStartTime.Subtract(Model.Sync.Start).ToString("c");
            var offsetOrdering = war.PreparationStartTime.Subtract(Model.Sync.Start.AddHours(-6)).ToString("c");
            var war_class = "";
            var opp_class = "";
            if (war.Result == "win")
            {
                war_class = "text-success";
                opp_class = "text-danger";
            }
            else if (war.Result == "lose")
            {
                war_class = "text-danger";
                opp_class = "text-success";
            }
            else
            {
                war_class = "text-muted";
                opp_class = "text-muted";
            }
            <tr class="@war_class">
                <td class="text-right text-nowrap">
                    <a class="@war_class table-search" asp-route-id="@war.ClanLinkID" asp-area="" asp-controller="Clans" asp-action="Details">@war.ClanName</a>
                    <br />
                    <small class="text-info">@war.ClanExpEarned xp</small>
                    <small class="text-muted">@war.ClanDestructionPercentage.ToString("0.#") %</small>
                    <small class="text-warning fw-bold">@war.ClanStars <span class="fas fa-star" /></small>
                </td>
                <td class="align-middle">
                    <img src="@war.ClanBadgeUrl" class="badge-35" />
                </td>
                <td class="text-nowrap text-center" width="35">
                    @war.Result
                    <br />
                    <small class="text-muted text-center text-nowrap">@war.TeamSize vs @war.TeamSize</small>
                </td>
                <td class="align-middle">
                    <img src="@war.OpponentBadgeUrl" class="badge-35" />
                </td>
                <td class="text-nowrap">
                    <a class="@opp_class table-search" asp-route-id="@war.OpponentLinkID" asp-area="" asp-controller="Clans" asp-action="Details">@war.OpponentName</a>
                    @if (!war.Matched)
                    {
                        if (war.Blacklisted)
                        {
                            <small class="badge text-bg-secondary">B<span class="d-none d-sm-inline">lacklisted</span></small>
                        }
                        else
                        {
                            <small class="badge text-bg-danger">W<span class="d-none d-sm-inline">ar clan</span></small>
                        }
                    }
                    <br />
                    <small class="text-warning fw-bold">@war.OpponentStars <span class="fas fa-star" /></small>
                    <small class="text-muted">@war.OpponentDestructionPercentage.ToString("0.#") %</small>
                </td>
                <td class="text-nowrap" data-sort="@offsetOrdering">
                    @offset
                    @if (!war.Synced)
                    {
                        <br />
                        <small class="badge text-bg-warning">Out of sync</small>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section scripts {
    <script type="text/javascript">
        (function() {
            initSyncsDetails();
        })();
    </script>
}