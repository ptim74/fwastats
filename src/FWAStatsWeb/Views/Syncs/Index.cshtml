@model FWAStatsWeb.Models.SyncViewModels.IndexViewModel

@{
    ViewBag.Title = "Syncs";
    ViewBag.MetaRobots = "nofollow";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Syncs</li>
    </ol>
</nav>

<h2>Syncs</h2>

<div class="input-group mb-4">
    <span class="input-group-text" id="basic-addon1"><span class="fas fa-search"></span></span>
    <input type="text" id="search" class="form-control" placeholder="Search" aria-describedby="basic-addon1" />
</div>

<table id="table" class="table table-hover table-responsive table-sort">
    <thead>
        <tr>
            <th width="35" data-sort-method="none"></th>
            <th>
                Clan
            </th>
            @foreach (var warSync in Model.Syncs)
            {
                <th>
                    <a asp-area="" asp-controller="Syncs" asp-action="Details" asp-route-id="@warSync.ID">@warSync.DisplayName</a>
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var clan in Model.Clans)
        {
            <tr>
                <td class="p-0">
                    <img src="@clan.BadgeUrl" class="badge-35" />
                </td>
                <td>
                    <a asp-route-id="@clan.LinkID" asp-area="" asp-controller="Clans" asp-action="Details" class="table-search">@clan.Name</a>
                    @if (clan.New)
                    {
                        <small class="badge text-bg-success">N<span class="d-none d-sm-inline">ew</span></small>
                    }
                    @if (clan.Departed)
                    {
                        <small class="badge text-bg-info">D<span class="d-none d-sm-inline">eparted</span></small>
                    }
                    @if (clan.HiddenLog)
                    {
                        <small class="badge text-bg-warning">H<span class="d-none d-sm-inline">idden log</span></small>
                    }
                    @if (clan.InLeague)
                    {
                        <small class="badge text-bg-primary">L<span class="d-none d-sm-inline">eague</span></small>
                    }
                </td>
                @foreach (var warResult in clan.Results)
                {
                    var result_class = "";
                    if (warResult.Result == "win")
                    {
                        result_class = "text-success";
                    }
                    else if (warResult.Result == "lose")
                    {
                        result_class = "text-danger";
                    }
                    else
                    {
                        result_class = "text-muted";
                    }
                    <td>
                        <a class="@result_class table-search" asp-route-id="@warResult.OpponentLinkID" asp-area="" asp-controller="Clans" asp-action="Details">@warResult.OpponentName</a>
                        @if (!string.IsNullOrEmpty(warResult.OpponentTag) && !warResult.IsAlliance)
                        {
                            if (warResult.OpponentIsBlacklisted)
                            {
                                <small class="badge text-bg-secondary">B<span class="d-none d-sm-inline">lacklisted</span></small>
                            }
                            else
                            {
                                <small class="badge text-bg-danger">W<span class="d-none d-sm-inline">ar clan</span></small>
                            }
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@section scripts {
    <script type="text/javascript">
        (function() {
            initSyncsIndex();
        })();
    </script>
}