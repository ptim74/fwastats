@model FWAStatsWeb.Models.UpdateViewModels.IndexViewModel

@{
    ViewBag.Title = "Update";
}

<h2>Update</h2>

<div class="alerts">
    @foreach (var error in Model.Errors)
    {
        <div class="alert alert-warning">
            <strong>Warning: </strong>@error
        </div>
    }
</div>

@{
    var taskIds = Model.Tasks.Select(task => task.ID.ToString()).ToList();
    var insert_count = Model.Tasks.Count(task => task.Mode == UpdateTaskMode.Insert);
    var update_count = Model.Tasks.Count(task => task.Mode == UpdateTaskMode.Update);
    var delete_count = Model.Tasks.Count(task => task.Mode == UpdateTaskMode.Delete);
}

<div>
    <dl class="dl-horizontal">
    <dt>
        Inserts
    </dt>
    <dd class="count-insert">
        @insert_count
    </dd>
    <dt>
        Updates
    </dt>
    <dd class="count-update">
        @update_count
    </dd>
    <dt>
        Deletes
    </dt>
    <dd class="count-delete">
        @delete_count
    </dd>
    </dl>
</div>

<div class="progress d-none">
    <div class="progress-bar progress-bar-success" role="progressbar" aria-valuenow="0"
         aria-valuemin="0" aria-valuemax="100" style="width:0%">
    </div>
</div>

<p>
    <button id="confirm-btn" type="button" class="btn btn-primary mt-3">Confirm</button>
</p>

@section scripts {
    <script type="text/javascript">
        (function() {
            initUpdateIndex({
                updates_remaining: @(Model.Tasks.Count),
                tasks: @Html.Raw(Json.Serialize(taskIds)),
                updateTaskUrl: '@Url.Action("UpdateTask","Update")',
                updateFinishedUrl: '@Url.Action("UpdateFinished", "Update")'
            });
        })();
    </script>
}