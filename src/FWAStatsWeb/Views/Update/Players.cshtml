@model FWAStatsWeb.Models.UpdateViewModels.PlayersViewModel

@{
    ViewBag.Title = "Update Players";
}

<h2>Update</h2>

<div class="alerts">
    @foreach (var error in Model.Errors)
    {
        <div class="alert alert-warning">
            <strong>Warning: </strong>@error
        </div>
    }
</div>

@{
    var task_delim = false;
    var player_count = Model.Tasks.Count;
}

<div>
    <dl class="dl-horizontal">
    <dt>
        Updates
    </dt>
    <dd class="count-player">
        @player_count
    </dd>
    </dl>
</div>

<div class="progress d-none">
    <div class="progress-bar progress-bar-success" role="progressbar" aria-valuenow="0"
         aria-valuemin="0" aria-valuemax="100" style="width:0%">
    </div>
</div>

<p>
    <button id="confirm-btn" type="button" class="btn btn-primary">Confirm</button>
</p>

@section scripts {
    <script type="text/javascript">
        (function() {
            initUpdatePlayers({
                updates_remaining: @player_count,
                tasks: [
                @foreach (var task in Model.Tasks)
                {
                    if(task_delim)
                    {
                        @:,'@task.LinkID'
                    }
                    else
                    {
                        task_delim = true;
                        @:'@task.LinkID'
                    }
                }
                ],
                updatePlayerTaskUrl: '@Url.Action("UpdatePlayerTask","Update")'
            });
        })();
    </script>
}